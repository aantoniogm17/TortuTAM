# Plantilla de variables de entorno de produccion para TortuTAM.Api.
#
# Este archivo de ejemplo SI se versiona (sin valores reales). El archivo
# real va solo en el servidor, en /etc/tortutam/api.env, con permisos
# restringidos (chmod 600, dueno tortutam:tortutam) y NUNCA se commitea.
#
# ASP.NET Core traduce automaticamente ConnectionStrings__DefaultConnection
# (doble guion bajo) a la clave de configuracion ConnectionStrings:DefaultConnection.

ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexion a SQL Server en el mismo VPS (localhost, nunca expuesto
# a internet). Reemplazar <PASSWORD_SA> por la contraseña real de SQL Server.
ConnectionStrings__DefaultConnection=Server=localhost;Database=TortuTAM;User Id=sa;Password=<PASSWORD_SA>;TrustServerCertificate=True;

# Minimo 32 caracteres. Generar uno propio, nunca reutilizar el de desarrollo.
Jwt__SigningKey=<GENERAR_CLAVE_UNICA_DE_PRODUCCION>

# Contraseña real de la cuenta Superadmin semilla (solo se usa la primera vez
# que arranca contra una base de datos sin usuarios).
IdentitySeed__SuperadminPassword=<ELEGIR_CONTRASEÑA_SEGURA>

# Ruta absoluta en el VPS donde se guardan las fotos de las fichas.
Storage__FichasFotosPath=/opt/tortutam/fotos
